NODE_ENV=development
PORT=3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=quickbite
DB_CONNECTION_LIMIT=10

# Use a unique random value of at least 32 characters. Never share or commit it.
JWT_SECRET=replace-this-with-a-long-random-secret
JWT_EXPIRES_IN=8h
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe123!
ADMIN_DISPLAY_NAME=Canteen Admin

# Leave empty to generate QR links from the URL used to open the admin panel.
PUBLIC_BASE_URL=
COOKIE_SECURE=false

# Keep 0 when accessing the app directly. Set to 1 behind Cloudflare Tunnel or
# another reverse proxy that overwrites X-Forwarded-For.
TRUST_PROXY=0

# Cancel unpaid orders after this many minutes. Use 0 to disable cleanup.
PENDING_ORDER_TTL_MINUTES=45

MAX_UPLOAD_MB=2
